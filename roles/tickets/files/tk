# --- storage -------------------------------------------------------------------

def db():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(DB_PATH.parent, 0o700)  # tickets are yours alone, not other accounts on this Mac
    conn = sqlite3.connect(DB_PATH, timeout=10)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.executescript(SCHEMA)
    have = {r[1] for r in conn.execute("PRAGMA table_info(tickets)")}
    for col, kind in (("decision", "TEXT"), ("decision_note", "TEXT"), ("decided_at", "REAL"), ("review", "TEXT"), ("status_since", "REAL"),
                      ("board", "TEXT NOT NULL DEFAULT 'agents'"), ("due", "TEXT"), ("waiting_on", "TEXT")):
        if col not in have:
            conn.execute(f"ALTER TABLE tickets ADD COLUMN {col} {kind}")
    return conn


def row(t):
    return dict(t) if t else None


def get(conn, tid):
    return row(conn.execute("SELECT * FROM tickets WHERE id = ?", (tid,)).fetchone())


def list_tickets(conn, project=None, status=None, include_done=False, board=None):
    sql, args = "SELECT * FROM tickets WHERE 1=1", []
    if board:
        sql += " AND board = ?"; args.append(board)
    if project:
        sql += " AND project = ?"; args.append(project)
    if status:
        sql += " AND status = ?"; args.append(status)
    elif not include_done:
        # keep a week of done tickets so the column isn't empty straight away
        sql += " AND (status != 'done' OR closed_at > ?)"; args.append(time.time() - 7 * 86400)
    sql += " ORDER BY priority, updated_at DESC"
    tickets = [row(t) for t in conn.execute(sql, args)]
    shots = {}
    for sh in conn.execute("SELECT ticket_id, file, caption FROM shots ORDER BY id"):
        shots.setdefault(sh["ticket_id"], []).append({"url": f"/shots/{sh['ticket_id']}/{sh['file']}", "caption": sh["caption"]})
    files = {}
    for at in conn.execute("SELECT * FROM attachments ORDER BY id"):
        files.setdefault(at["ticket_id"], []).append(attachment_json(at))
    for t in tickets:
        t["shots"] = shots.get(t["id"], [])
        t["attachments"] = files.get(t["id"], [])
    return tickets


def attachment_json(at):
    url = at["target"] if at["kind"] == "link" else f"/files/{at['ticket_id']}/{at['target']}"
    return {"id": at["id"], "kind": at["kind"], "url": url, "label": at["label"] or at["target"],
            "image": at["kind"] == "file" and Path(at["target"]).suffix in IMAGE_TYPES}


def create(conn, title, project="", body="", status="backlog", priority=2, board="agents", due=None, waiting_on=None):
    if status not in STATUSES:
        raise ValueError(f"unknown status {status!r}")
    if board not in BOARDS:
        raise ValueError(f"unknown board {board!r}")
    now = time.time()
    cur = conn.execute(
        "INSERT INTO tickets (title, body, project, status, priority, created_at, updated_at, closed_at, status_since,"
        " board, due, waiting_on) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
        (title.strip(), body, project, status, int(priority), now, now, now if status == "done" else None, now,
         board, parse_due(due) if due else None, waiting_on or None),
    )
    conn.commit()
    return get(conn, cur.lastrowid)


def update(conn, tid, source="manual", **changes):
    t = get(conn, tid)
    if not t:
        raise KeyError(tid)
    internal = {k: changes.pop(k) for k in ("decision", "decision_note", "decided_at", "review") if k in changes}
    changes = {k: v for k, v in changes.items() if k in FIELDS and v is not None}
    for k in ("workspace_id", "worktree", "branch", "pr_url", "due", "waiting_on"):
        if changes.get(k) == "":
            changes[k] = None  # clearing a field
    if changes.get("due"):
        changes["due"] = parse_due(changes["due"])
    if "board" in changes and changes["board"] not in BOARDS:
        raise ValueError(f"unknown board {changes['board']!r}")
    if "status" in changes:
        if changes["status"] not in STATUSES:
            raise ValueError(f"unknown status {changes['status']!r}")
        changes["status_source"] = source
        if changes["status"] != t["status"]:
            changes["status_since"] = time.time()
        changes["closed_at"] = time.time() if changes["status"] == "done" else None
        if changes["status"] in ("backlog", "todo", "working", "needs-you"):
            # back to work: the review decision belonged to the round that ended
            changes.update(decision=None, decision_note=None, decided_at=None, review=None)
            clear_shots(conn, tid)  # screenshots belong to the review round that ended
    changes.update(internal)
    if not changes:
        return t
    changes["updated_at"] = time.time()
    cols = ", ".join(f"{k} = ?" for k in changes)
    conn.execute(f"UPDATE tickets SET {cols} WHERE id = ?", (*changes.values(), tid))
    conn.commit()
    return get(conn, tid)


def decide(conn, tid, decision, note=""):
    """Record the user's review decision: approved, changes (sent back) or None to clear."""
    t = get(conn, tid)
    if not t:
        raise KeyError(tid)
    if decision not in ("approved", "changes", None):
        raise ValueError(f"unknown decision {decision!r}")
    if decision and t["status"] != "review":
        raise ValueError(f"#{tid} is {t['status']}; only tickets in review can be approved or sent back")
    if decision == "changes" and not (note or "").strip():
        raise ValueError("say what needs changing")
    return update(conn, tid, decision=decision, decision_note=(note or "").strip() or None,
                  decided_at=time.time() if decision else None)


WEEKDAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]


def parse_due(text, today=None):
    """today, tomorrow/tmr, mon..sun (next one), +3d, 2026-10-15, 15/10 or 15/10/2026 → ISO date."""
    import datetime as dt
    today = today or dt.date.today()
    s = str(text).strip().lower()
    if s in ("today", "tod"):
        d = today
    elif s in ("tomorrow", "tmr", "tom"):
        d = today + dt.timedelta(days=1)
    elif s in WEEKDAYS or s in ("monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday", "tues", "thur", "thurs"):
        ahead = (WEEKDAYS.index(s[:3]) - today.weekday()) % 7 or 7
        d = today + dt.timedelta(days=ahead)
    elif re.fullmatch(r"\+\d+d", s):
        d = today + dt.timedelta(days=int(s[1:-1]))
    elif re.fullmatch(r"\d{4}-\d{2}-\d{2}", s):
        d = dt.date.fromisoformat(s)
    elif m := re.fullmatch(r"(\d{1,2})/(\d{1,2})(?:/(\d{2,4}))?", s):
        year = int(m[3]) + (2000 if m[3] and len(m[3]) == 2 else 0) if m[3] else today.year
        d = dt.date(year, int(m[2]), int(m[1]))
        if not m[3] and d < today:
            d = d.replace(year=year + 1)
    else:
        raise ValueError(f"can't read {text!r} as a date (try today, fri, +3d, 15/10)")
    return d.isoformat()


def split_due(words):
    """'Order phone for Jess fri' → ('Order phone for Jess', '2026-10-09'); no trailing date → (text, None)."""
    parts = words.strip().split()
    if len(parts) > 1:
        try:
            return " ".join(parts[:-1]), parse_due(parts[-1])
        except ValueError:
            pass
    return words.strip(), None


def add_link(conn, tid, url, label=""):
    if not get(conn, tid):
        raise KeyError(tid)
    if not re.match(r"^(https?|mailto|file|slack|obsidian):", url or ""):
        raise ValueError("links must start with http(s):, mailto:, file:, slack: or obsidian:")
    cur = conn.execute("INSERT INTO attachments (ticket_id, kind, target, label, created_at) VALUES (?, 'link', ?, ?, ?)",
                       (tid, url, label, time.time()))
    conn.commit()
    return cur.lastrowid


def add_file(conn, tid, name, data, label=""):
    if not get(conn, tid):
        raise KeyError(tid)
    if len(data) > 25 * 1024 * 1024:
        raise ValueError("files are limited to 25 MB")
    stem, suffix = Path(name).stem, Path(name).suffix.lower()
    safe = re.sub(r"[^a-z0-9]+", "-", stem.lower()).strip("-")[:50] or "file"
    suffix = suffix if re.fullmatch(r"\.[a-z0-9]{1,8}", suffix) else ""
    folder = FILES / str(tid)
    folder.mkdir(parents=True, exist_ok=True)
    stored, n = f"{safe}{suffix}", 1
    while (folder / stored).exists():
        n += 1; stored = f"{safe}-{n}{suffix}"
    (folder / stored).write_bytes(data)
    cur = conn.execute("INSERT INTO attachments (ticket_id, kind, target, label, created_at) VALUES (?, 'file', ?, ?, ?)",
                       (tid, stored, label or Path(name).name, time.time()))
    conn.commit()
    return cur.lastrowid


def remove_attachment(conn, aid):
    at = conn.execute("SELECT * FROM attachments WHERE id = ?", (aid,)).fetchone()
    if not at:
        raise KeyError(aid)
    if at["kind"] == "file":
        (FILES / str(at["ticket_id"]) / at["target"]).unlink(missing_ok=True)
    conn.execute("DELETE FROM attachments WHERE id = ?", (aid,))
    conn.commit()


def add_shot(conn, tid, src, caption=""):
    if not get(conn, tid):
        raise KeyError(tid)
    src = Path(src).expanduser()
    if src.suffix.lower() not in IMAGE_TYPES:
        raise ValueError(f"{src.name}: only {', '.join(IMAGE_TYPES)} images")
    if not src.is_file() or src.stat().st_size > 15 * 1024 * 1024:
        raise ValueError(f"{src}: not a file, or over 15 MB")
    folder = SHOTS / str(tid)
    folder.mkdir(parents=True, exist_ok=True)
    n = conn.execute("SELECT COUNT(*) FROM shots WHERE ticket_id = ?", (tid,)).fetchone()[0] + 1
    name = f"{n:02d}-{re.sub(r'[^a-z0-9]+', '-', (caption or src.stem).lower()).strip('-')[:40].rstrip('-') or 'shot'}{src.suffix.lower()}"
    shutil.copyfile(src, folder / name)
    conn.execute("INSERT INTO shots (ticket_id, file, caption, created_at) VALUES (?, ?, ?, ?)", (tid, name, caption, time.time()))
    conn.commit()
    return name


def clear_shots(conn, tid):
    conn.execute("DELETE FROM shots WHERE ticket_id = ?", (tid,))
    shutil.rmtree(SHOTS / str(tid), ignore_errors=True)


BACKUP_DIR = Path.home() / "Library/Mobile Documents/com~apple~CloudDocs/Backups/tickets"


def backup(dest=BACKUP_DIR, keep=14):
    """Zip a consistent copy of the database plus files, screenshots and briefs; keep the newest `keep`."""
    import datetime as dt, tempfile, zipfile
    dest = Path(dest).expanduser()
    dest.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y-%m-%d")
    out = dest / f"tickets-{stamp}.zip"
    with tempfile.TemporaryDirectory() as tmp:
        snap = Path(tmp) / "tickets.db"
        src = sqlite3.connect(DB_PATH)
        dst = sqlite3.connect(snap)
        src.backup(dst)  # safe while the board is writing
        dst.close(); src.close()
        part = out.with_suffix(".zip.part")
        with zipfile.ZipFile(part, "w", zipfile.ZIP_DEFLATED) as z:
            z.write(snap, "tickets.db")
            for folder in ("files", "shots", "briefs"):
                base = DB_PATH.parent / folder
                for f in sorted(base.rglob("*")) if base.is_dir() else []:
                    if f.is_file():
                        z.write(f, f"{folder}/{f.relative_to(base)}")
        part.replace(out)
    for old in sorted(dest.glob("tickets-*.zip"))[:-keep]:
        old.unlink()
    return out


def restore(archive):
    """Replace the board's data with a backup zip; the current data is kept beside it first."""
    import datetime as dt, zipfile
    archive = Path(archive).expanduser()
    with zipfile.ZipFile(archive) as z:
        names = z.namelist()
        if "tickets.db" not in names or any(n.startswith("/") or ".." in Path(n).parts for n in names):
            raise ValueError(f"{archive.name} doesn't look like a tickets backup")
        home = DB_PATH.parent
        aside = home.with_name(f"tickets-before-restore-{dt.datetime.now():%Y%m%d-%H%M%S}")
        if home.exists():
            home.rename(aside)
        home.mkdir(parents=True, mode=0o700)
        z.extractall(home)
    for keep in ("tk.log",):
        if (aside / keep).exists():
            shutil.copy2(aside / keep, home / keep)
    return aside


def delete(conn, tid):
    clear_shots(conn, tid)
    conn.execute("DELETE FROM attachments WHERE ticket_id = ?", (tid,))
    shutil.rmtree(FILES / str(tid), ignore_errors=True)
    conn.execute("DELETE FROM tickets WHERE id = ?", (tid,))
    conn.commit()


# --- cmux sync -------------------------------------------------------------------

def cmux_bin():
    return os.environ.get("CMUX_BUNDLED_CLI_PATH") or shutil.which("cmux") or "/Applications/cmux.app/Contents/Resources/bin/cmux"


_warned = False


def cmux_lane(workspace_id):
    """The board column a workspace's cmux lane maps to, or None when unknown."""
    try:
        out = subprocess.run(
            [cmux_bin(), "workspace", "status", "--workspace", workspace_id, "--json"],
            capture_output=True, text=True, timeout=5,
        )
        if out.returncode != 0:
            global _warned
            if not _warned:  # outside cmux (e.g. launchd) access is refused; say so once
                print(f"cmux status unavailable: {out.stderr.strip()[:200]}", file=sys.stderr)
                _warned = True
            return None
        s = json.loads(out.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    sig = s.get("signals") or {}
    if sig.get("has_pull_requests") and sig.get("all_pull_requests_merged_or_closed"):
        return "done"
    return s.get("effective")


def sync(conn):
    """Move linked tickets when their cmux lane changes; manual moves stick until it changes again."""
    moved = []
    for t in conn.execute("SELECT * FROM tickets WHERE workspace_id IS NOT NULL AND status != 'done'").fetchall():
        lane = cmux_lane(t["workspace_id"])
        if lane is None or lane == t["last_lane"]:
            continue
        conn.execute("UPDATE tickets SET last_lane = ? WHERE id = ?", (lane, t["id"]))
        target = LANES.get(lane)
        # Review belongs to the user and the conductor: a worker doing a follow-up
        # (e.g. approved doc edits) must not drag the ticket back or wipe the decision.
        if t["status"] == "review" and target != "done":
            continue
        if target and target != t["status"]:
            update(conn, t["id"], source="auto", status=target)
            moved.append({"id": t["id"], "from": t["status"], "to": target})
    conn.commit()
    return moved


# --- diff size ----------------------------------------------------------------

_diff_cache = {}


def diff_stat(worktree):
    """(+added, -removed) of a worktree against where its branch left the base, uncommitted work included."""
    hit = _diff_cache.get(worktree)
    if hit and time.time() - hit[0] < 20:
        return hit[1]
    stat = None
    try:
        def git(*a):
            return subprocess.run(["git", "-C", worktree, *a], capture_output=True, text=True, timeout=5)
        base = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD").stdout.strip()
        if not base:
            base = next((b for b in ("main", "master") if git("rev-parse", "--verify", "--quiet", b).returncode == 0), "")
        fork = git("merge-base", "HEAD", base).stdout.strip() if base else ""
        out = git("diff", "--numstat", fork).stdout if fork else ""
        added = removed = 0
        for line in out.splitlines():
            a, r, _ = (line.split("\t") + ["", ""])[:3]
            added += int(a) if a.isdigit() else 0
            removed += int(r) if r.isdigit() else 0
        stat = {"added": added, "removed": removed} if fork else None
    except (OSError, subprocess.TimeoutExpired):
        pass
    _diff_cache[worktree] = (time.time(), stat)
    return stat


# --- helpers ---------------------------------------------------------------------

def current_project():
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=2).stdout.strip()
    except OSError:
        top = ""
    return Path(top or os.getcwd()).name


def ago(ts):
    m = int((time.time() - ts) // 60)
    return f"{m}m" if m < 60 else f"{m // 60}h" if m < 1440 else f"{m // 1440}d"


def print_tickets(tickets):
    if not tickets:
        print("No tickets.")
        return
    for status in STATUSES:
        group = [t for t in tickets if t["status"] == status]
        if not group:
            continue
        print(f"\n{status.upper()} ({len(group)})")
        for t in group:
            extra = " · ".join(x for x in [t["project"], t["due"] and f"due {t['due']}", t.get("waiting_on") and f"waiting on {t['waiting_on']}",
                                          t["branch"] and f"⎇ {t['branch']}", t["pr_url"] and "PR"] if x)
            mark = {"approved": " ✓ approved", "changes": " ↩ sent back"}.get(t["decision"], "")
            print(f"  #{t['id']:<4} {'!' * (4 - t['priority'])} {t['title']}{mark}  {f'[{extra}] ' if extra else ''}{ago(t['updated_at'])}")



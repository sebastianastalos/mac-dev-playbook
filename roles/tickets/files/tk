<script>
const COLS=[["backlog","Backlog","var(--dim)"],["todo","Todo","var(--blue)"],["working","Working","var(--orange)"],["needs-you","Needs you","var(--amber)"],["review","Review","var(--purple)"],["done","Done","var(--green)"]];
const H={"Content-Type":"application/json","X-Tickets":"1"};
let tickets=[],dragging=null,editing=null;
const $=s=>document.querySelector(s),esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const api=(m,u,b)=>fetch(u,{method:m,headers:H,body:b&&JSON.stringify(b)}).then(r=>{if(!r.ok)throw new Error(r.status);return r.json()});
const ago=t=>{const m=Math.floor((Date.now()/1e3-t)/60);return m<60?m+"m":m<1440?Math.floor(m/60)+"h":Math.floor(m/1440)+"d"};
try{const p=localStorage.getItem("tk.project");if(p!==null)$("#project").dataset.want=p}catch(e){}
function render(){
  const proj=$("#project").value,shown=tickets.filter(t=>!proj||t.project===proj);
  const projects=[...new Set(tickets.map(t=>t.project).filter(Boolean))].sort();
  const sel=$("#project"),want=sel.dataset.want??sel.value;
  sel.innerHTML='<option value="">All projects</option>'+projects.map(p=>`<option>${esc(p)}</option>`).join("");
  sel.value=projects.includes(want)?want:"";delete sel.dataset.want;
  $("#projects").innerHTML=projects.map(p=>`<option value="${esc(p)}">`).join("");
  $("#count").textContent=`${shown.filter(t=>t.status!=="done").length} open`;
  $("#board").innerHTML=COLS.map(([id,name,color])=>{
    const items=shown.filter(t=>t.status===id);
    return `<section class="col" data-status="${id}"><h2><span class="dot" style="background:${color}"></span>${name}<span class="spacer"></span>${items.length}</h2>
    ${id==="backlog"||id==="todo"?`<form class="add" data-status="${id}"><input placeholder="+ Add ticket" name="title"></form>`:""}
    ${items.map(t=>`<article class="card" draggable="true" data-id="${t.id}"><div class="t">${esc(t.title)}</div>
    <div class="m"><span>#${t.id}</span>${t.priority==1?'<span class="p1">● high</span>':""}${t.project?`<span class="chip">${esc(t.project)}</span>`:""}
    ${t.branch?`<span>⎇ ${esc(t.branch)}</span>`:""}${t.pr_url?`<a href="${esc(t.pr_url)}" target="_blank">PR</a>`:""}${(t.shots||[]).length?`<span title="screenshots">▣ ${t.shots.length}</span>`:""}<span>${ago(t.updated_at)}</span></div>${verdict(t)}</article>`).join("")}</section>`}).join("");
}
function verdict(t){
  if(t.status!=="review")return "";
  if(t.decision==="approved")return `<div class="verdict ok">✓ Approved${t.pr_url?"":" – conductor will push and open the PR"}</div>`;
  if(t.decision==="changes")return `<div class="verdict chg">↩ Sent back: ${esc(t.decision_note)}</div>`;
  if(!t.review)return `<div class="verdict">⏳ Conductor is reviewing</div>`;
  return `<div class="acts"><button class="approve" data-act="approve">Approve</button><button class="back" data-act="back">Send back</button></div>`;
}
function md(src){
  const inline=s=>esc(s).replace(/`([^`]+)`/g,"<code>$1</code>").replace(/\*\*([^*]+)\*\*/g,"<b>$1</b>");
  let out="",list=false;
  for(const raw of String(src||"").split("\n")){const l=raw.trimEnd();
    const li=l.match(/^\s*[-*•]\s+(.*)/);
    if(li){if(!list){out+="<ul>";list=true}out+=`<li>${inline(li[1])}</li>`;continue}
    if(list){out+="</ul>";list=false}
    const h=l.match(/^#{1,6}\s+(.*)/);
    if(h)out+=`<h5>${inline(h[1])}</h5>`;else if(l.trim())out+=`<p style="margin:4px 0">${inline(l)}</p>`;
  }
  return out+(list?"</ul>":"");
}
function goal(body){const m=String(body||"").match(/##\s*Goal\s*\n([\s\S]*?)(\n##\s|$)/);
  return (m?m[1]:String(body||"").slice(0,400)).trim()||"(no brief)"}
let reviewing=null;

@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.7)}}
@media (prefers-reduced-motion:reduce){.pulse{animation:none}}.p1{color:var(--red)}.p3{opacity:.7}
.card a{color:var(--green);text-decoration:none}
.acts{display:flex;gap:6px;margin-top:8px}.acts button{padding:3px 9px;font-size:12px}.approve{color:var(--green);border-color:#7ec69966}.back{color:var(--amber)}
#rv{width:min(720px,94vw)}#rv h3{margin:0 0 2px;font-size:16px}#rv .meta{color:var(--dim);font-size:12px;margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap}
#rv h4{margin:14px 0 4px;font-size:11.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--dim)}#rv .md{line-height:1.5}#rv .md ul{margin:4px 0;padding-left:18px}
#rv .md code{background:var(--card);border:1px solid var(--edge);border-radius:4px;padding:0 4px;font-size:12px}#rv .md h5{margin:12px 0 4px;font-size:13px}
#rv .shots{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px}#rv figure{margin:0}
#rv figure img{width:100%;border-radius:8px;border:1px solid var(--edge);display:block;cursor:zoom-in}#rv figcaption{font-size:11.5px;color:var(--dim);margin-top:4px}
#rv .wait{color:var(--dim);font-style:italic}#rv .actions a{color:var(--dim);align-self:center;cursor:pointer}
.verdict{margin-top:7px;font-size:12px;border-radius:6px;padding:4px 7px;border:1px solid var(--edge)}.verdict.ok{color:var(--green)}.verdict.chg{color:var(--amber)}.add input{width:100%}
dialog{background:var(--bg);color:var(--text);border:1px solid var(--edge);border-radius:12px;width:min(520px,92vw);padding:16px}
dialog::backdrop{background:#0008}dialog label{display:block;font-size:11.5px;color:var(--dim);margin:8px 0 3px}dialog input,dialog textarea,dialog select{width:100%}
dialog textarea{min-height:120px;resize:vertical}.row{display:flex;gap:8px}.row>*{flex:1}.actions{display:flex;gap:8px;margin-top:14px}.danger{color:var(--red)}
@media (max-width:700px){main{grid-template-columns:repeat(6,82vw)}}
</style></head><body>
<header><h1>Tickets</h1>
<div class="views" role="tablist"><button data-view="tasks">Tasks</button><button data-view="agents">Agents</button></div>
<select id="project"><option value="">All projects</option></select>
<span class="muted" id="count"></span><span class="spacer"></span><button id="sync" title="Pull status from cmux">Sync</button></header>
<main id="board"></main>
<datalist id="projects"></datalist>
<dialog id="rv"><form method="dialog"><div class="body"></div><div class="actions acts2"></div></form></dialog>
<dialog id="back"><form method="dialog" id="backform"><label>What needs changing?</label>
<textarea name="note" placeholder="The worker gets this as its next instruction"></textarea>
<div class="actions"><button value="send">Send back</button><button value="cancel" formnovalidate>Cancel</button></div></form></dialog>
<dialog id="edit"><form method="dialog" id="form">
<label>Title</label><input name="title" required>
<div class="row"><div><label>Project</label><input name="project" list="projects"></div>
<div><label>Priority</label><select name="priority"><option value="1">High</option><option value="2">Normal</option><option value="3">Low</option></select></div>
<div><label>Status</label><select name="status"></select></div></div>
<div class="row task-only"><div><label>Due</label><input name="due" type="date"></div><div><label>Waiting on</label><input name="waiting_on" placeholder="Who or what you're waiting for"></div></div>
<label>Details</label><textarea name="body"></textarea>
<div class="agent-only"><div class="row"><div><label>Branch</label><input name="branch"></div><div><label>PR URL</label><input name="pr_url"></div></div>
<label>Worktree</label><input name="worktree"><label>cmux workspace</label><input name="workspace_id"></div>
<label>Attachments</label>
<div id="att" class="att"></div>
<div class="drop" id="drop">Drop files or paste a screenshot here · <label class="pick">choose files<input type="file" id="pickfile" multiple hidden></label></div>
<div class="row linkrow"><input id="linkurl" placeholder="https://… link"><input id="linklabel" placeholder="Label (optional)"><button type="button" id="addlink">Add link</button></div>
<div class="row"><div><label>Board</label><select name="board"><option value="tasks">Tasks</option><option value="agents">Agents</option></select></div><div></div><div></div></div>
<div class="actions"><button value="save">Save</button><button value="cancel" formnovalidate>Cancel</button><span class="spacer"></span><button value="delete" class="danger" formnovalidate>Delete</button></div>
</form></dialog>
<script>
const VIEWS={
  agents:[["backlog","Backlog","var(--dim)"],["todo","Todo","var(--blue)"],["working","Working","var(--orange)"],["needs-you","Needs you","var(--amber)"],["review","Review","var(--purple)"],["done","Done","var(--green)"]],
  tasks:[["todo","To do","var(--blue)"],["working","Doing","var(--orange)"],["waiting","Waiting on someone","var(--amber)"],["done","Done","var(--green)"]]};
const GH=`<svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true" style="vertical-align:-1px;margin-right:3px"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>`;
const ICO=(d)=>`<svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-1px;margin-right:3px">${d}</svg>`;
const PIC=ICO(`<rect x="1.75" y="2.75" width="12.5" height="10.5" rx="2"/><circle cx="5.5" cy="6.25" r="1.25"/><path d="M14.25 10.5l-3.5-3.5-6.5 6.25"/>`);
const CLOCK=ICO(`<circle cx="8" cy="8" r="6.25"/><path d="M8 4.75V8l2.25 1.5"/>`);
const CAL=ICO(`<rect x="2" y="3" width="12" height="11" rx="2"/><path d="M2 6.5h12M5.5 1.75v2.5M10.5 1.75v2.5"/>`);
const CLIP=ICO(`<path d="M13.5 7.5l-5.6 5.6a3.5 3.5 0 01-5-5l6-6a2.3 2.3 0 013.3 3.3l-6 6a1.2 1.2 0 01-1.7-1.7l5.5-5.5"/>`);
const LINK=ICO(`<path d="M6.5 9.5a3 3 0 004.2 0l2.3-2.3a3 3 0 00-4.2-4.2L7.6 4.2"/><path d="M9.5 6.5a3 3 0 00-4.2 0L3 8.8a3 3 0 004.2 4.2l1.2-1.2"/>`);
const HOURGLASS=ICO(`<path d="M4 1.75h8M4 14.25h8M5 1.75c0 3 6 3.5 6 6.25s-6 3.25-6 6.25M11 1.75c0 3-6 3.5-6 6.25s6 3.25 6 6.25"/>`);
const H={"Content-Type":"application/json","X-Tickets":"1"};
let tickets=[],dragging=null,editing=null,backing=null,reviewing=null,view="tasks";
const $=s=>document.querySelector(s),esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const api=(m,u,b)=>fetch(u,{method:m,headers:H,body:b&&JSON.stringify(b)}).then(r=>{if(!r.ok)return r.json().then(j=>{throw new Error(j.error||r.status)});return r.json()});
const ago=t=>{const m=Math.floor((Date.now()/1e3-t)/60);return m<60?m+"m":m<1440?Math.floor(m/60)+"h":Math.floor(m/1440)+"d"};
const store=(k,v)=>{try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){return null}};
view=store("tk.view")||"tasks";
{const p=store("tk.project");if(p!==null)$("#project").dataset.want=p}
const todayISO=()=>{const d=new Date();return new Date(d.getTime()-d.getTimezoneOffset()*6e4).toISOString().slice(0,10)};
function dueChip(t){if(!t.due||t.status==="done")return t.due?`<span>${CAL}${fmtDate(t.due)}</span>`:"";
  const days=Math.round((Date.parse(t.due)-Date.parse(todayISO()))/864e5);
  const cls=days<0?"due late":days<=1?"due soon":"due";
  const txt=days<0?`overdue ${-days}d`:days===0?"due today":days===1?"due tomorrow":days<7?`due ${new Date(t.due).toLocaleDateString(undefined,{weekday:"short"})}`:`due ${fmtDate(t.due)}`;
  return `<span class="${cls}" title="Due ${esc(t.due)}">${CAL}${txt}</span>`}
const fmtDate=iso=>new Date(iso+"T12:00").toLocaleDateString(undefined,{day:"numeric",month:"short"});
function render(){
  document.querySelectorAll(".views button").forEach(b=>b.classList.toggle("on",b.dataset.view===view));
  const cols=VIEWS[view],mine=tickets.filter(t=>(t.board||"agents")===view);
  const proj=$("#project").value,shown=mine.filter(t=>!proj||t.project===proj);
  const projects=[...new Set(mine.map(t=>t.project).filter(Boolean))].sort();
  const sel=$("#project"),want=sel.dataset.want??sel.value;
  sel.innerHTML='<option value="">All projects</option>'+projects.map(p=>`<option>${esc(p)}</option>`).join("");
  sel.value=projects.includes(want)?want:"";delete sel.dataset.want;
  sel.style.display=projects.length?"":"none";
  $("#projects").innerHTML=projects.map(p=>`<option value="${esc(p)}">`).join("");
  $("#count").textContent=`${shown.filter(t=>t.status!=="done").length} open`;
  $("#sync").style.display=view==="agents"?"":"none";
  badge();
  const main=$("#board");main.style.gridTemplateColumns=`repeat(${cols.length},minmax(200px,1fr))`;
  main.innerHTML=cols.map(([id,name,color])=>{
    let items=shown.filter(t=>t.status===id);
    if(view==="tasks"&&id!=="done")items=items.sort((a,b)=>(a.due||"9999").localeCompare(b.due||"9999")||a.priority-b.priority);
    const addable=view==="tasks"?id==="todo":(id==="backlog"||id==="todo");
    return `<section class="col" data-status="${id}"><h2><span class="dot" style="background:${color}"></span>${name}<span class="spacer"></span>${items.length}</h2>
    ${addable?`<form class="add" data-status="${id}"><input placeholder="${view==="tasks"?"+ Add task (end with fri, tmr, 15/10…)":"+ Add ticket"}" name="title"></form>`:""}
    ${items.map(card).join("")}</section>`}).join("");
}
function card(t){const n=(t.attachments||[]).length;
  return `<article class="card" draggable="true" data-id="${t.id}"><div class="t">${esc(t.title)}</div>
  <div class="m"><span>#${t.id}</span>${t.priority==1?'<span class="p1">● high</span>':""}${t.project?`<span class="chip">${esc(t.project)}</span>`:""}
  ${dueChip(t)}${t.status==="waiting"&&t.waiting_on?`<span class="wait-on">${HOURGLASS}${esc(t.waiting_on)}</span>`:""}
  ${t.branch?`<span>⎇ ${esc(t.branch)}</span>`:""}${t.pr_url?`<a href="${esc(t.pr_url)}" target="_blank">${GH}PR</a>`:""}
  ${(t.shots||[]).length?`<span title="Screenshots">${PIC}${t.shots.length}</span>`:""}${n?`<span title="Attachments">${CLIP}${n}</span>`:""}
  ${t.diff&&(t.diff.added||t.diff.removed)?`<span title="Lines changed"><span class="add-n">+${t.diff.added}</span> <span class="del-n">−${t.diff.removed}</span></span>`:""}${timer(t)}</div>${verdict(t)}</article>`}
function timer(t){const since=t.status_since||t.updated_at;
  if((t.board||"agents")==="agents"&&t.status==="working")return `<span class="live w" title="Working since">${CLOCK}working ${ago(since)}</span>`;
  if(t.status==="needs-you")return `<span class="live n" title="Waiting since"><span class="pulse"></span>waiting ${ago(since)}</span>`;
  if(t.status==="waiting")return `<span title="Waiting since">${CLOCK}${ago(since)}</span>`;
  return `<span title="Last updated">${CLOCK}${ago(t.updated_at)}</span>`}
const ICON=document.querySelector('link[rel="icon"]'),BASE_ICON=ICON.href;
function waitingOnYou(){const today=todayISO();return tickets.filter(t=>t.status==="needs-you"||(t.status==="review"&&t.review&&!t.decision)||(t.board==="tasks"&&t.status!=="done"&&t.status!=="waiting"&&t.due&&t.due<=today)).length}
function badge(){const n=waitingOnYou();document.title=n?`(${n}) Tickets`:"Tickets";
  ICON.href=n?BASE_ICON.replace("%3C/svg%3E","%3Ccircle cx='25' cy='25' r='6.5' fill='%23e5b567' stroke='%232a2a2e' stroke-width='2.5'/%3E%3C/svg%3E"):BASE_ICON}
function verdict(t){
  if(t.status!=="review")return "";
  if(t.decision==="approved")return `<div class="verdict ok">✓ Approved${t.pr_url?"":" – conductor will push and open the PR"}</div>`;
  if(t.decision==="changes")return `<div class="verdict chg">↩ Sent back: ${esc(t.decision_note)}</div>`;
  if(!t.review)return `<div class="verdict">⏳ Conductor is reviewing</div>`;
  return `<div class="acts"><button class="approve" data-act="approve">Approve</button><button class="back" data-act="back">Send back</button></div>`;
}
function md(src){
  const inline=s=>esc(s).replace(/`([^`]+)`/g,"<code>$1</code>").replace(/\*\*([^*]+)\*\*/g,"<b>$1</b>");
  let out="",list=false;
  for(const raw of String(src||"").split("\n")){const l=raw.trimEnd();
    const li=l.match(/^\s*[-*•]\s+(.*)/);
    if(li){if(!list){out+="<ul>";list=true}out+=`<li>${inline(li[1])}</li>`;continue}
    if(list){out+="</ul>";list=false}
    const h=l.match(/^#{1,6}\s+(.*)/);
    if(h)out+=`<h5>${inline(h[1])}</h5>`;else if(l.trim())out+=`<p style="margin:4px 0">${inline(l)}</p>`;
  }
  return out+(list?"</ul>":"");
}
function goal(body){const m=String(body||"").match(/##\s*Goal\s*\n([\s\S]*?)(\n##\s|$)/);
  return (m?m[1]:String(body||"").slice(0,400)).trim()||"(no brief)"}
function openReview(t){reviewing=t;const rv=$("#rv");
  rv.querySelector(".body").innerHTML=`<h3>#${t.id} ${esc(t.title)}</h3>
  <div class="meta">${t.project?`<span class="chip">${esc(t.project)}</span>`:""}${t.branch?`<span>⎇ ${esc(t.branch)}</span>`:""}${t.pr_url?`<a href="${esc(t.pr_url)}" target="_blank">${GH}PR</a>`:""}</div>
  <h4>Asked for</h4><div class="md">${md(goal(t.body))}</div>
  ${t.review?`<div class="md">${md(t.review)}</div>`:`<h4>Review</h4><p class="wait">Waiting for the conductor's review.</p>`}
  ${(t.shots||[]).length?`<h4>Screenshots</h4><div class="shots">${t.shots.map(s=>`<figure><a href="${esc(s.url)}" target="_blank"><img src="${esc(s.url)}" alt="${esc(s.caption)}" loading="lazy"></a>${s.caption?`<figcaption>${esc(s.caption)}</figcaption>`:""}</figure>`).join("")}</div>`:""}
  ${t.decision==="approved"?`<div class="verdict ok">✓ Approved${t.pr_url?"":" – conductor will push and open the PR"}</div>`:""}
  ${t.decision==="changes"?`<div class="verdict chg">↩ Sent back: ${esc(t.decision_note)}</div>`:""}`;
  rv.querySelector(".acts2").innerHTML=(t.review&&!t.decision?`<button class="approve" value="approve">Approve</button><button class="back" value="back">Send back…</button>`:"")+
    `<button value="close" autofocus>Close</button><span class="spacer"></span><a data-edit>Edit ticket ›</a>`;
  rv.showModal()}
async function load(){if(dragging||editing||backing||reviewing)return;try{tickets=await api("GET","/api/tickets");render()}catch(e){}}
document.querySelectorAll(".views button").forEach(b=>b.onclick=()=>{view=b.dataset.view;store("tk.view",view);$("#project").value="";render()});
$("#project").onchange=()=>{store("tk.project",$("#project").value);render()};
$("#sync").onclick=async()=>{await api("POST","/api/sync");load()};
document.addEventListener("submit",async e=>{const f=e.target;if(!f.classList.contains("add"))return;e.preventDefault();
  const title=f.title.value.trim();if(!title)return;
  await api("POST","/api/tickets",{title,status:f.dataset.status,project:$("#project").value,board:view,quick:view==="tasks"});f.reset();load()});
document.addEventListener("dragstart",e=>{const c=e.target.closest(".card");if(c){dragging=c.dataset.id;e.dataTransfer.setData("text/plain",dragging)}});
document.addEventListener("dragend",()=>{dragging=null;document.querySelectorAll(".over").forEach(x=>x.classList.remove("over"))});
document.addEventListener("dragover",e=>{const col=e.target.closest(".col");if(col&&dragging){e.preventDefault();document.querySelectorAll(".over").forEach(x=>x!==col&&x.classList.remove("over"));col.classList.add("over")}});
document.addEventListener("drop",async e=>{const col=e.target.closest(".col");if(!col||!dragging)return;e.preventDefault();const id=dragging;dragging=null;
  const t=tickets.find(x=>x.id==id);if(t)t.status=col.dataset.status;render();await api("PATCH","/api/tickets/"+id,{status:col.dataset.status});load()});
const dlg=$("#edit"),form=$("#form");
const backDlg=$("#back"),backForm=$("#backform");
document.addEventListener("click",async e=>{const b=e.target.closest("button[data-act]");if(!b)return;e.stopPropagation();
  const id=b.closest(".card").dataset.id;
  if(b.dataset.act==="approve"){await api("POST",`/api/tickets/${id}/decision`,{decision:"approved"});load()}
  else{backing=id;backForm.note.value="";backDlg.showModal()}},true);
backDlg.addEventListener("close",async()=>{const id=backing;backing=null;
  if(id&&backDlg.returnValue==="send"&&backForm.note.value.trim()){await api("POST",`/api/tickets/${id}/decision`,{decision:"changes",note:backForm.note.value});}
  load()});
// --- edit dialog + attachments ---
const FIELDS_EDIT=["title","project","priority","status","body","branch","pr_url","worktree","workspace_id","due","waiting_on","board"];
function renderAtt(t){const list=t.attachments||[];
  $("#att").innerHTML=list.length?list.map(a=>`<div class="att-item">${a.image?`<a href="${esc(a.url)}" target="_blank"><img src="${esc(a.url)}" alt=""></a>`:""}
    <a href="${esc(a.url)}" target="_blank" class="att-name">${a.kind==="link"?LINK:CLIP}${esc(a.label)}</a>
    <button type="button" class="x" data-del="${a.id}" title="Remove">×</button></div>`).join(""):`<p class="muted" style="margin:2px 0">None yet.</p>`}
async function refreshEditing(){const all=await api("GET","/api/tickets");tickets=all;const t=all.find(x=>x.id===editing.id);if(t){editing=t;renderAtt(t)}}
function openEdit(t){editing=t;const b=t.board||"agents";
  form.status.innerHTML=VIEWS[b].map(([id,name])=>`<option value="${id}">${name}</option>`).join("");
  for(const k of FIELDS_EDIT)form[k].value=t[k]??(k==="board"?"agents":"");
  form.classList.toggle("is-task",b==="tasks");renderAtt(t);$("#linkurl").value="";$("#linklabel").value="";dlg.showModal()}
form.board.onchange=()=>{const b=form.board.value,cur=form.status.value;form.status.innerHTML=VIEWS[b].map(([id,name])=>`<option value="${id}">${name}</option>`).join("");
  form.status.value=VIEWS[b].some(c=>c[0]===cur)?cur:"todo";form.classList.toggle("is-task",b==="tasks")};
async function upload(files){for(const f of files){
  await fetch(`/api/tickets/${editing.id}/files`,{method:"POST",headers:{"X-Tickets":"1","X-Filename":encodeURIComponent(f.name||"pasted.png"),"Content-Type":"application/octet-stream"},body:f})}
  await refreshEditing()}
$("#pickfile").onchange=e=>{upload([...e.target.files]);e.target.value=""};
const drop=$("#drop");
drop.addEventListener("dragover",e=>{e.preventDefault();e.stopPropagation();drop.classList.add("over")});
drop.addEventListener("dragleave",()=>drop.classList.remove("over"));
drop.addEventListener("drop",e=>{e.preventDefault();e.stopPropagation();drop.classList.remove("over");upload([...e.dataTransfer.files])});
dlg.addEventListener("paste",e=>{const files=[...(e.clipboardData?.files||[])];if(!files.length)return;e.preventDefault();
  upload(files.map((f,i)=>f.name&&f.name!=="image.png"?f:new File([f],`screenshot-${new Date().toISOString().slice(0,19).replace(/[T:]/g,"-")}${i?"-"+i:""}.png`,{type:f.type})))});
$("#addlink").onclick=async()=>{const url=$("#linkurl").value.trim();if(!url)return;
  try{await api("POST",`/api/tickets/${editing.id}/links`,{url:/^[a-z]+:/i.test(url)?url:"https://"+url,label:$("#linklabel").value.trim()})}catch(err){alertLine(err.message);return}
  $("#linkurl").value="";$("#linklabel").value="";refreshEditing()};
$("#linkurl").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();$("#addlink").click()}});
$("#att").addEventListener("click",async e=>{const x=e.target.closest("[data-del]");if(!x)return;await api("DELETE",`/api/attachments/${x.dataset.del}`);refreshEditing()});
function alertLine(msg){$("#att").insertAdjacentHTML("beforeend",`<p class="del-n" style="margin:4px 0">${esc(msg)}</p>`)}
const rvDlg=$("#rv");
rvDlg.addEventListener("click",e=>{if(e.target.closest("[data-edit]")){const t=reviewing;rvDlg.close("edit");openEdit(t)}});
rvDlg.addEventListener("close",async()=>{const t=reviewing;reviewing=null;if(!t)return;
  if(rvDlg.returnValue==="approve"){await api("POST",`/api/tickets/${t.id}/decision`,{decision:"approved"})}
  else if(rvDlg.returnValue==="back"){backing=String(t.id);backForm.note.value="";backDlg.showModal();return}
  load()});
document.addEventListener("click",e=>{const c=e.target.closest(".card");if(!c||e.target.closest("a,button"))return;
  const t=tickets.find(x=>x.id==c.dataset.id);if(t.status==="review"||(t.status==="done"&&t.review)){openReview(t);return}openEdit(t)});
dlg.addEventListener("close",async()=>{const t=editing;editing=null;if(!t)return;
  if(dlg.returnValue==="delete"){await api("DELETE","/api/tickets/"+t.id)}
  else if(dlg.returnValue==="save"){const d=Object.fromEntries(new FormData(form));d.priority=+d.priority;
    for(const k of["branch","pr_url","worktree","workspace_id"])if(d[k]===undefined)delete d[k];
    try{await api("PATCH","/api/tickets/"+t.id,d)}catch(err){}}
  load()});
load();setInterval(load,4000);
</script></body></html>"""


class Board(BaseHTTPRequestHandler):
    server_version = "tk"

    def log_message(self, *a):
        pass

    def _send(self, code, payload=None, ctype="application/json", headers=None):
        body = payload if isinstance(payload, bytes) else payload.encode() if isinstance(payload, str) else json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def _allowed(self, mutating):
        # Only answer for our own host (blocks DNS rebinding); writes need a custom
        # header, which a cross-site page can't send without a CORS preflight we refuse.
        host = self.headers.get("Host", "")
        if host not in (f"127.0.0.1:{self.server.server_port}", f"localhost:{self.server.server_port}"):
            return False
        return not mutating or self.headers.get("X-Tickets") == "1"

    def _json(self):
        n = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(n) or b"{}")

    def _route(self, method):
        mutating = method != "GET"
        if not self._allowed(mutating):
            return self._send(403, {"error": "forbidden"})
        path = self.path.split("?")[0]
        conn = db()
        try:
            if method == "GET" and path == "/":
                return self._send(200, PAGE, "text/html; charset=utf-8")
            img = re.fullmatch(r"/shots/(\d+)/([a-z0-9-]+\.(?:png|jpe?g|webp))", path)
            if method == "GET" and img:
                f = SHOTS / img[1] / img[2]
                if not f.is_file():
                    return self._send(404, {"error": "no such screenshot"})
                return self._send(200, f.read_bytes(), IMAGE_TYPES[f.suffix])
            fm = re.fullmatch(r"/files/(\d+)/([a-z0-9-]+(?:\.[a-z0-9]{1,8})?)", path)
            if method == "GET" and fm:
                f = FILES / fm[1] / fm[2]
                if not f.is_file():
                    return self._send(404, {"error": "no such file"})
                inline = INLINE_TYPES.get(f.suffix)
                at = conn.execute("SELECT label FROM attachments WHERE ticket_id = ? AND target = ?", (int(fm[1]), fm[2])).fetchone()
                name = re.sub(r'[^\w. -]', "_", at["label"] if at else f.name)
                return self._send(200, f.read_bytes(), inline or "application/octet-stream",
                                  {"Content-Disposition": f'{"inline" if inline else "attachment"}; filename="{name}"'})
            if method == "GET" and path == "/api/tickets":
                tickets = list_tickets(conn)
                for t in tickets:
                    if t["worktree"] and t["branch"] and Path(t["worktree"]).is_dir():
                        t["diff"] = diff_stat(t["worktree"])
                return self._send(200, tickets)
            if method == "POST" and path == "/api/tickets":
                d = self._json()
                if not str(d.get("title", "")).strip():
                    return self._send(400, {"error": "title required"})
                title, due = (split_due(d["title"]) if d.get("quick") else (d["title"], d.get("due")))
                return self._send(201, create(conn, title, d.get("project", ""), d.get("body", ""),
                                              d.get("status", "backlog"), d.get("priority", 2),
                                              d.get("board", "agents"), due, d.get("waiting_on")))
            if method == "POST" and path == "/api/sync":
                return self._send(200, sync(conn))
            m = re.fullmatch(r"/api/tickets/(\d+)", path)
            if m and method == "PATCH":
                return self._send(200, update(conn, int(m[1]), **self._json()))
            lk = re.fullmatch(r"/api/tickets/(\d+)/links", path)
            if lk and method == "POST":
                body = self._json()
                return self._send(201, {"id": add_link(conn, int(lk[1]), body.get("url", "").strip(), body.get("label", ""))})
            up = re.fullmatch(r"/api/tickets/(\d+)/files", path)
            if up and method == "POST":
                from urllib.parse import unquote
                n = int(self.headers.get("Content-Length") or 0)
                if n > 25 * 1024 * 1024:
                    return self._send(413, {"error": "files are limited to 25 MB"})
                name = unquote(self.headers.get("X-Filename", "file"))
                return self._send(201, {"id": add_file(conn, int(up[1]), name, self.rfile.read(n))})
            ra = re.fullmatch(r"/api/attachments/(\d+)", path)
            if ra and method == "DELETE":
                remove_attachment(conn, int(ra[1]))
                return self._send(200, {"deleted": int(ra[1])})
            d = re.fullmatch(r"/api/tickets/(\d+)/decision", path)
            if d and method == "POST":
                body = self._json()
                return self._send(200, decide(conn, int(d[1]), body.get("decision"), body.get("note", "")))
            if m and method == "DELETE":
                delete(conn, int(m[1]))
                return self._send(200, {"deleted": int(m[1])})
            return self._send(404, {"error": "not found"})
        except KeyError:
            return self._send(404, {"error": "no such ticket"})
        except ValueError as e:
            return self._send(400, {"error": str(e)})
        finally:
            conn.close()

    def do_GET(self):
        self._route("GET")

    def do_POST(self):
        self._route("POST")

    def do_PATCH(self):
        self._route("PATCH")

    def do_DELETE(self):
        self._route("DELETE")


def serve(port):
    def loop():
        while True:
            try:
                conn = db(); sync(conn); conn.close()
            except Exception as e:  # keep the board up if cmux is unreachable
                print(f"sync failed: {e}", file=sys.stderr)
            time.sleep(15)

    threading.Thread(target=loop, daemon=True).start()
    print(f"Tickets board on http://127.0.0.1:{port}")
    ThreadingHTTPServer(("127.0.0.1", port), Board).serve_forever()



  const title=f.title.value.trim();if(!title)return;await api("POST","/api/tickets",{title,status:f.dataset.status,project:$("#project").value});f.reset();load()});
document.addEventListener("dragstart",e=>{const c=e.target.closest(".card");if(c){dragging=c.dataset.id;e.dataTransfer.setData("text/plain",dragging)}});
document.addEventListener("dragend",()=>{dragging=null;document.querySelectorAll(".over").forEach(x=>x.classList.remove("over"))});

  <h4>Asked for</h4><div class="md">${md(goal(t.body))}</div>
  ${t.review?`<div class="md">${md(t.review)}</div>`:`<h4>Review</h4><p class="wait">Waiting for the conductor's review.</p>`}
  ${(t.shots||[]).length?`<h4>Screenshots</h4><div class="shots">${t.shots.map(s=>`<figure><a href="${esc(s.url)}" target="_blank"><img src="${esc(s.url)}" alt="${esc(s.caption)}" loading="lazy"></a>${s.caption?`<figcaption>${esc(s.caption)}</figcaption>`:""}</figure>`).join("")}</div>`:""}
  ${t.decision==="approved"?`<div class="verdict ok">✓ Approved${t.pr_url?"":" – conductor will push and open the PR"}</div>`:""}
  ${t.decision==="changes"?`<div class="verdict chg">↩ Sent back: ${esc(t.decision_note)}</div>`:""}`;
  rv.querySelector(".acts2").innerHTML=(t.review&&!t.decision?`<button class="approve" value="approve">Approve</button><button class="back" value="back">Send back…</button>`:"")+
    `<button value="close" autofocus>Close</button><span class="spacer"></span><a data-edit>Edit ticket ›</a>`;
  rv.showModal()}
async function load(){if(dragging||editing||backing||reviewing)return;try{tickets=await api("GET","/api/tickets");render()}catch(e){}}

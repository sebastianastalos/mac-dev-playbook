#!/usr/bin/env python3
"""tk – local ticket board shared by every project, linked to cmux workspaces.

Data lives in ~/.local/share/tickets/tickets.db. `tk serve` runs the web board
on http://127.0.0.1:7717; `tk --help` lists the commands.
"""
import argparse, json, os, re, shutil, sqlite3, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

DB_PATH = Path(os.environ.get("TK_DB", Path.home() / ".local/share/tickets/tickets.db"))
PORT = int(os.environ.get("TK_PORT", "7717"))
STATUSES = ["backlog", "todo", "working", "needs-you", "review", "done"]
# cmux lane → board column; lanes not listed leave the ticket alone
LANES = {"working": "working", "needs-attention": "needs-you", "review": "review", "done": "done"}
FIELDS = ["title", "body", "project", "status", "priority", "workspace_id", "worktree", "branch", "pr_url"]

SCHEMA = """
CREATE TABLE IF NOT EXISTS tickets (
  id INTEGER PRIMARY KEY,
  title TEXT NOT NULL,
  body TEXT NOT NULL DEFAULT '',
  project TEXT NOT NULL DEFAULT '',
  status TEXT NOT NULL DEFAULT 'backlog',
  priority INTEGER NOT NULL DEFAULT 2,
  workspace_id TEXT, worktree TEXT, branch TEXT, pr_url TEXT,
  status_source TEXT NOT NULL DEFAULT 'manual',
  last_lane TEXT,
  created_at REAL NOT NULL, updated_at REAL NOT NULL, closed_at REAL
);
"""


# --- storage -------------------------------------------------------------------

def db():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=10)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.executescript(SCHEMA)
    return conn


def row(t):
    return dict(t) if t else None


def get(conn, tid):
    return row(conn.execute("SELECT * FROM tickets WHERE id = ?", (tid,)).fetchone())


def list_tickets(conn, project=None, status=None, include_done=False):
    sql, args = "SELECT * FROM tickets WHERE 1=1", []
    if project:
        sql += " AND project = ?"; args.append(project)
    if status:
        sql += " AND status = ?"; args.append(status)
    elif not include_done:
        # keep a week of done tickets so the column isn't empty straight away
        sql += " AND (status != 'done' OR closed_at > ?)"; args.append(time.time() - 7 * 86400)
    sql += " ORDER BY priority, updated_at DESC"
    return [row(t) for t in conn.execute(sql, args)]


def create(conn, title, project="", body="", status="backlog", priority=2):
    if status not in STATUSES:
        raise ValueError(f"unknown status {status!r}")
    now = time.time()
    cur = conn.execute(
        "INSERT INTO tickets (title, body, project, status, priority, created_at, updated_at, closed_at)"
        " VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
        (title.strip(), body, project, status, int(priority), now, now, now if status == "done" else None),
    )
    conn.commit()
    return get(conn, cur.lastrowid)


def update(conn, tid, source="manual", **changes):
    t = get(conn, tid)
    if not t:
        raise KeyError(tid)
    changes = {k: v for k, v in changes.items() if k in FIELDS and v is not None}
    for k in ("workspace_id", "worktree", "branch", "pr_url"):
        if changes.get(k) == "":
            changes[k] = None  # clearing a link
    if "status" in changes:
        if changes["status"] not in STATUSES:
            raise ValueError(f"unknown status {changes['status']!r}")
        changes["status_source"] = source
        changes["closed_at"] = time.time() if changes["status"] == "done" else None
    if not changes:
        return t
    changes["updated_at"] = time.time()
    cols = ", ".join(f"{k} = ?" for k in changes)
    conn.execute(f"UPDATE tickets SET {cols} WHERE id = ?", (*changes.values(), tid))
    conn.commit()
    return get(conn, tid)


def delete(conn, tid):
    conn.execute("DELETE FROM tickets WHERE id = ?", (tid,))
    conn.commit()


# --- cmux sync -------------------------------------------------------------------

def cmux_bin():
    return os.environ.get("CMUX_BUNDLED_CLI_PATH") or shutil.which("cmux") or "/Applications/cmux.app/Contents/Resources/bin/cmux"


_warned = False


def cmux_lane(workspace_id):
    """The board column a workspace's cmux lane maps to, or None when unknown."""
    try:
        out = subprocess.run(
            [cmux_bin(), "workspace", "status", "--workspace", workspace_id, "--json"],
            capture_output=True, text=True, timeout=5,
        )
        if out.returncode != 0:
            global _warned
            if not _warned:  # outside cmux (e.g. launchd) access is refused; say so once
                print(f"cmux status unavailable: {out.stderr.strip()[:200]}", file=sys.stderr)
                _warned = True
            return None
        s = json.loads(out.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    sig = s.get("signals") or {}
    if sig.get("has_pull_requests") and sig.get("all_pull_requests_merged_or_closed"):
        return "done"
    return s.get("effective")


def sync(conn):
    """Move linked tickets when their cmux lane changes; manual moves stick until it changes again."""
    moved = []
    for t in conn.execute("SELECT * FROM tickets WHERE workspace_id IS NOT NULL AND status != 'done'").fetchall():
        lane = cmux_lane(t["workspace_id"])
        if lane is None or lane == t["last_lane"]:
            continue
        conn.execute("UPDATE tickets SET last_lane = ? WHERE id = ?", (lane, t["id"]))
        target = LANES.get(lane)
        if target and target != t["status"]:
            update(conn, t["id"], source="auto", status=target)
            moved.append({"id": t["id"], "from": t["status"], "to": target})
    conn.commit()
    return moved


# --- helpers ---------------------------------------------------------------------

def current_project():
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=2).stdout.strip()
    except OSError:
        top = ""
    return Path(top or os.getcwd()).name


def ago(ts):
    m = int((time.time() - ts) // 60)
    return f"{m}m" if m < 60 else f"{m // 60}h" if m < 1440 else f"{m // 1440}d"


def print_tickets(tickets):
    if not tickets:
        print("No tickets.")
        return
    for status in STATUSES:
        group = [t for t in tickets if t["status"] == status]
        if not group:
            continue
        print(f"\n{status.upper()} ({len(group)})")
        for t in group:
            extra = " · ".join(x for x in [t["project"], t["branch"] and f"⎇ {t['branch']}", t["pr_url"] and "PR"] if x)
            print(f"  #{t['id']:<4} {'!' * (4 - t['priority'])} {t['title']}  [{extra}] {ago(t['updated_at'])}")



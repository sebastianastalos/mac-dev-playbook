class Board(BaseHTTPRequestHandler):
    server_version = "tk"

    def log_message(self, *a):
        pass

    def _send(self, code, payload=None, ctype="application/json"):
        body = payload if isinstance(payload, bytes) else payload.encode() if isinstance(payload, str) else json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _allowed(self, mutating):
        # Only answer for our own host (blocks DNS rebinding); writes need a custom
        # header, which a cross-site page can't send without a CORS preflight we refuse.
        host = self.headers.get("Host", "")
        if host not in (f"127.0.0.1:{self.server.server_port}", f"localhost:{self.server.server_port}"):
            return False
        return not mutating or self.headers.get("X-Tickets") == "1"

    def _json(self):
        n = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(n) or b"{}")

    def _route(self, method):
        mutating = method != "GET"
        if not self._allowed(mutating):
            return self._send(403, {"error": "forbidden"})
        path = self.path.split("?")[0]
        conn = db()
        try:
            if method == "GET" and path == "/":
                return self._send(200, PAGE, "text/html; charset=utf-8")
            img = re.fullmatch(r"/shots/(\d+)/([a-z0-9-]+\.(?:png|jpe?g|webp))", path)
            if method == "GET" and img:
                f = SHOTS / img[1] / img[2]
                if not f.is_file():
                    return self._send(404, {"error": "no such screenshot"})
                return self._send(200, f.read_bytes(), IMAGE_TYPES[f.suffix])
            if method == "GET" and path == "/api/tickets":
                return self._send(200, list_tickets(conn))
            if method == "POST" and path == "/api/tickets":
                d = self._json()
                if not str(d.get("title", "")).strip():
                    return self._send(400, {"error": "title required"})
                return self._send(201, create(conn, d["title"], d.get("project", ""), d.get("body", ""),
                                              d.get("status", "backlog"), d.get("priority", 2)))
            if method == "POST" and path == "/api/sync":
                return self._send(200, sync(conn))
            m = re.fullmatch(r"/api/tickets/(\d+)", path)
            if m and method == "PATCH":
                return self._send(200, update(conn, int(m[1]), **self._json()))
            d = re.fullmatch(r"/api/tickets/(\d+)/decision", path)
            if d and method == "POST":
                body = self._json()
                return self._send(200, decide(conn, int(d[1]), body.get("decision"), body.get("note", "")))
            if m and method == "DELETE":
                delete(conn, int(m[1]))
                return self._send(200, {"deleted": int(m[1])})
            return self._send(404, {"error": "not found"})
        except KeyError:
            return self._send(404, {"error": "no such ticket"})
        except ValueError as e:
            return self._send(400, {"error": str(e)})
        finally:
            conn.close()

    def do_GET(self):
        self._route("GET")

    def do_POST(self):
        self._route("POST")

    def do_PATCH(self):
        self._route("PATCH")

    def do_DELETE(self):
        self._route("DELETE")


def serve(port):
    def loop():
        while True:
            try:
                conn = db(); sync(conn); conn.close()
            except Exception as e:  # keep the board up if cmux is unreachable
                print(f"sync failed: {e}", file=sys.stderr)
            time.sleep(15)

    threading.Thread(target=loop, daemon=True).start()
    print(f"Tickets board on http://127.0.0.1:{port}")
    ThreadingHTTPServer(("127.0.0.1", port), Board).serve_forever()


# --- CLI ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(prog="tk", description="Local ticket board linked to cmux.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("add", help="create a ticket")
    p.add_argument("title"); p.add_argument("-p", "--project"); p.add_argument("-d", "--body", default="")
    p.add_argument("-s", "--status", default="backlog", choices=STATUSES); p.add_argument("-P", "--priority", type=int, default=2, choices=[1, 2, 3])
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("ls", help="list tickets")
    p.add_argument("-p", "--project", help="project name, or . for the current repo"); p.add_argument("-s", "--status", choices=STATUSES)
    p.add_argument("-a", "--all", action="store_true", help="include all done tickets"); p.add_argument("--json", action="store_true")

    p = sub.add_parser("show", help="show one ticket"); p.add_argument("id", type=int); p.add_argument("--json", action="store_true")
    p = sub.add_parser("mv", help="move a ticket to a column"); p.add_argument("id", type=int); p.add_argument("status", choices=STATUSES)

    p = sub.add_parser("edit", help="change a ticket's fields")
    p.add_argument("id", type=int); p.add_argument("--title"); p.add_argument("-d", "--body"); p.add_argument("-p", "--project")
    p.add_argument("-P", "--priority", type=int, choices=[1, 2, 3])

    p = sub.add_parser("link", help="link a ticket to a cmux workspace, worktree, branch or PR")
    p.add_argument("id", type=int); p.add_argument("--workspace", help="workspace UUID, or 'here'")
    p.add_argument("--worktree"); p.add_argument("--branch"); p.add_argument("--pr")

    p = sub.add_parser("approve", help="approve a ticket in review"); p.add_argument("id", type=int); p.add_argument("-m", "--note", default="")
    p = sub.add_parser("send-back", help="send a ticket in review back with changes"); p.add_argument("id", type=int); p.add_argument("-m", "--note", required=True)
    p = sub.add_parser("review", help="attach the conductor's review report (markdown)")
    p.add_argument("id", type=int); g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("-m", "--text"); g.add_argument("-f", "--file", help="file, or - for stdin")
    p = sub.add_parser("undecide", help="clear a review decision"); p.add_argument("id", type=int)
    p = sub.add_parser("shot", help="attach a screenshot to a ticket's review (png/jpg/webp)")
    p.add_argument("id", type=int); p.add_argument("image", nargs="?"); p.add_argument("-c", "--caption", default="")
    p.add_argument("--clear", action="store_true", help="remove this ticket's screenshots")
    p = sub.add_parser("done", help="mark done"); p.add_argument("id", type=int)
    p = sub.add_parser("rm", help="delete a ticket"); p.add_argument("id", type=int)
    p = sub.add_parser("sync", help="pull status from cmux"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("serve", help="run the web board"); p.add_argument("--port", type=int, default=PORT)
    sub.add_parser("open", help="open the board in a cmux browser pane")

    a = ap.parse_args()
    conn = db()
    try:
        if a.cmd == "add":
            t = create(conn, a.title, a.project or current_project(), a.body, a.status, a.priority)
            print(json.dumps(t) if a.json else f"Created #{t['id']} {t['title']} ({t['project']}, {t['status']})")
        elif a.cmd == "ls":
            project = current_project() if a.project == "." else a.project
            ts = list_tickets(conn, project, a.status, a.all)
            print(json.dumps(ts)) if a.json else print_tickets(ts)
        elif a.cmd == "show":
            t = get(conn, a.id) or sys.exit(f"No ticket #{a.id}")
            if a.json:
                print(json.dumps(t))
            else:
                for k in ["id", "title", "project", "status", "decision", "decision_note", "priority", "branch", "worktree", "workspace_id", "pr_url"]:
                    if t[k] not in (None, ""):
                        print(f"{k:>13}: {t[k]}")
                if t["body"]:
                    print("\n" + t["body"])
                if t.get("review"):
                    print("\n--- review ---\n" + t["review"])
        elif a.cmd == "mv":
            t = update(conn, a.id, status=a.status); print(f"#{t['id']} → {t['status']}")
        elif a.cmd == "edit":
            t = update(conn, a.id, title=a.title, body=a.body, project=a.project, priority=a.priority); print(f"Updated #{t['id']}")
        elif a.cmd == "link":
            ws = os.environ.get("CMUX_WORKSPACE_ID") if a.workspace == "here" else a.workspace
            if a.workspace == "here" and not ws:
                sys.exit("Not inside a cmux workspace")
            t = update(conn, a.id, workspace_id=ws, worktree=a.worktree and str(Path(a.worktree).resolve()), branch=a.branch, pr_url=a.pr)
            print(f"Linked #{t['id']}")
        elif a.cmd == "approve":
            decide(conn, a.id, "approved", a.note); print(f"#{a.id} approved")
        elif a.cmd == "send-back":
            decide(conn, a.id, "changes", a.note); print(f"#{a.id} sent back")
        elif a.cmd == "review":
            text = a.text if a.text is not None else (sys.stdin.read() if a.file == "-" else Path(a.file).read_text())
            if (get(conn, a.id) or {}).get("status") != "review":
                sys.exit(f"#{a.id} isn't in review")
            update(conn, a.id, review=text.strip()); print(f"Review attached to #{a.id}")
        elif a.cmd == "shot":
            if a.clear:
                clear_shots(conn, a.id); conn.commit(); print(f"Cleared screenshots of #{a.id}")
            elif a.image:
                img = a.image[7:] if a.image.startswith("file://") else a.image
                print(f"Attached {add_shot(conn, a.id, img, a.caption)} to #{a.id}")
            else:
                sys.exit("give an image path, or --clear")
        elif a.cmd == "undecide":
            decide(conn, a.id, None); print(f"#{a.id} decision cleared")
        elif a.cmd == "done":
            t = update(conn, a.id, status="done"); print(f"#{t['id']} done")
        elif a.cmd == "rm":
            get(conn, a.id) or sys.exit(f"No ticket #{a.id}"); delete(conn, a.id); print(f"Deleted #{a.id}")
        elif a.cmd == "sync":
            moved = sync(conn)
            print(json.dumps(moved) if a.json else "\n".join(f"#{m['id']} {m['from']} → {m['to']}" for m in moved) or "Nothing to move.")
        elif a.cmd == "serve":
            serve(a.port)
        elif a.cmd == "open":
            url = f"http://127.0.0.1:{PORT}"
            if subprocess.run([cmux_bin(), "browser", "open-split", url], capture_output=True).returncode != 0:
                subprocess.run(["open", url])
    except KeyError as e:
        sys.exit(f"No ticket #{e.args[0]}")
    except ValueError as e:
        sys.exit(str(e))
    finally:
        conn.close()


if __name__ == "__main__":
    main()

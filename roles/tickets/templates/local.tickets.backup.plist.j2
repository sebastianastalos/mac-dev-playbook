<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.tickets.backup</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>{{ tickets_home }}/.local/bin/tk</string><string>backup</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardErrorPath</key><string>{{ tickets_home }}/.local/share/tickets/backup.log</string>
  <key>StandardOutPath</key><string>{{ tickets_home }}/.local/share/tickets/backup.log</string>
</dict>
</plist>

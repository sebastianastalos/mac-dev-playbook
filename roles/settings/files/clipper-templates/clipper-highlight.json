{
  "schemaVersion": "0.1.0",
  "name": "Highlight",
  "behavior": "create",
  "noteContentFormat": "> [!quote] Selected from [{{title}}]({{url}})\n\n{{selectionHtml|markdown}}\n\n{{highlights}}\n",
  "properties": [
    {
      "name": "title",
      "value": "{{title}}",
      "type": "text"
    },
    {
      "name": "source",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "author",
      "value": "{{author}}",
      "type": "text"
    },
    {
      "name": "published",
      "value": "{{published|date:\\\"YYYY-MM-DD\\\"}}",
      "type": "date"
    },
    {
      "name": "clipped",
      "value": "{{date|date:\\\"YYYY-MM-DD\\\"}}",
      "type": "date"
    },
    {
      "name": "site",
      "value": "{{site}}",
      "type": "text"
    },
    {
      "name": "tags",
      "value": "clipping",
      "type": "multitext"
    }
  ],
  "triggers": [],
  "noteNameFormat": "{{title|replace:\"/\":\" - \"|replace:\":\":\" -\"|safe_name|trim}}",
  "path": "Clippings/"
}
